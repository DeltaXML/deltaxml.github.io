{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "xslt",
			"label": "createVSCodePages",
			"saxonJar": "${config:XSLT.tasks.saxonJar}",
			"xsltFile": "${workspaceFolder}/vscode-xslt-xpath/xsl/createPages.xsl",
			"xmlSource": "${workspaceFolder}/vscode-xslt-xpath/authoring/layout.xml",
			"resultPath": "${workspaceFolder}/vscode-xslt-xpath/xslt-out/result1.xml",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$saxon-xslt"
			]
		},
		{
			// the whole guide as a PDF, from all-pages.html - after building the pages. Needs WeasyPrint
			// (brew install weasyprint); -D 200 limits screenshots to 200 dpi, to keep the PDF small
			"type": "shell",
			"label": "createVSCodePDF",
			"command": "weasyprint",
			"args": [
				"--optimize-images",
				"-D",
				"200",
				"--pdf-tags",
				"all-pages.html",
				"vscode-xslt-xpath-guide.pdf"
			],
			"options": {
				"cwd": "${workspaceFolder}/vscode-xslt-xpath"
			},
			"dependsOn": "createVSCodePages",
			"group": "build",
			"problemMatcher": []
		}
	]
}